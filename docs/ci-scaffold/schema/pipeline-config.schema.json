{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ispaces.dev/schema/pipeline-config.schema.json",
  "title": "PipelineConfig",
  "description": "Artefact immuable et versionne decrivant un pipeline (rag, guardrail, infra). Valide structurellement au stage 1 du workflow CI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "meta", "spec"],
  "properties": {
    "api_version": {
      "const": "pipeline/v1",
      "description": "Version du contrat de config."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "semver", "domain", "owner_team"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80,
          "description": "Nom unique de la config."
        },
        "semver": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Version semantique, invariante (immutabilite)."
        },
        "domain": {
          "type": "string",
          "enum": ["rag", "guardrail", "infra"]
        },
        "owner_team": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages", "gates", "rollback"],
      "properties": {
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validate", "test", "promote"],
          "properties": {
            "validate": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean", "default": true },
                "schema_ref": { "type": "string" }
              }
            },
            "test": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean", "default": true },
                "suites": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "promote": {
              "type": "object",
              "properties": {
                "strategy": {
                  "type": "string",
                  "enum": ["manual", "auto"]
                },
                "approvals_required": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "deploy": {
              "type": "object",
              "properties": {
                "canary_enabled": { "type": "boolean", "default": false },
                "drift_check_enabled": { "type": "boolean", "default": true }
              }
            }
          }
        },
        "gates": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["schema", "invariants", "lint", "secret_scan", "tests"]
              },
              "minItems": 1
            }
          }
        },
        "parameters": {
          "type": "object",
          "patternProperties": {
            "^(staging|production)$": { "type": "object" }
          },
          "additionalProperties": false
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keep_previous_versions"],
          "properties": {
            "keep_previous_versions": {
              "type": "integer",
              "minimum": 1,
              "description": "Invariant : >= 1 si un environnement production est defini."
            }
          }
        }
      }
    }
  }
}

# Alloba gateway — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Service binding ----------------------------------------------------------
ALLOBA_HOST=0.0.0.0
ALLOBA_PORT=8582

# Platform backend this gateway proxies everything non-gateway to
# (ispaces Commerce / AfroMART backend, port 8561).
ALLOBA_BACKEND_URL=http://localhost:8561

# --- RAG knowledge engine ------------------------------------------------------
ALLOBA_RAG_INDEX_DIR=./rag_index
ALLOBA_RAG_DOCS_DIR=./kb/docs
ALLOBA_EMBEDDING_MODEL=nomic-embed-text
ALLOBA_RAG_TOP_K=4

# --- Local LLM (Ollama) ---------------------------------------------------------
ALLOBA_OLLAMA_BASE_URL=http://127.0.0.1:11434
ALLOBA_LLM_MODEL=llama3.2:1b

# --- Agentic sourcing -----------------------------------------------------------
# pipeline | tools | auto
ALLOBA_AGENT_MODE=auto
ALLOBA_AGENT_TOOL_MODELS=qwen3.5,qwen3.6,qwen2.5,llama3.3
ALLOBA_AGENT_MAX_STEPS=6
ALLOBA_AGENT_DEFAULT_LANGUAGE=en

# --- CORS (never *) --------------------------------------------------------------
ALLOBA_ALLOWED_ORIGINS=http://localhost:3005,http://localhost:8582

# --- Alloba Training (immersive micro-training / certification) ---------------------
# SQLite in dev; docker-compose overrides this with the PostgreSQL URL.
ALLOBA_TRAINING_DATABASE_URL=sqlite:///./data/alloba_training.db
ALLOBA_TRAINING_ALLOWED_ORIGINS=http://localhost:3020,http://127.0.0.1:3020
# Inter-service API key (LTI/HRIS/ingestion). Empty = dev.
ALLOBA_TRAINING_API_KEY=
# Optional generative scenario branching via Ollama.
ALLOBA_TRAINING_OLLAMA_BASE_URL=http://127.0.0.1:11434
ALLOBA_TRAINING_OLLAMA_MODEL=llama3.2
# Docker Compose only: PostgreSQL credentials for the training service.
ALLOBA_TRAINING_POSTGRES_USER=alloba_training
ALLOBA_TRAINING_POSTGRES_PASSWORD=changeme_in_prod
ALLOBA_TRAINING_POSTGRES_DB=alloba_training
